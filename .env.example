PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:4000

# -------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# -------------------------------------------------------------
# You can use:
# - Free Neon Postgres: postgresql://username:password@ep-cool-fog-12345.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# - Free Supabase Postgres: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# - Local Docker / PostgreSQL: postgresql://postgres:postgres@localhost:5432/meherban_db?schema=public
# (Note: If DATABASE_URL is not set, Meherban runs automatically in Safe In-Memory mode)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meherban_db?schema=public"

# -------------------------------------------------------------
# 2. CLOUDINARY CONFIGURATION (Product Image Uploads)
# -------------------------------------------------------------
# Create a free account at https://cloudinary.com
# Find these 3 values in your Cloudinary Dashboard:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# -------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# -------------------------------------------------------------
JWT_SECRET=super_secret_meherban_jwt_key_2026_dev
JWT_EXPIRES_IN=7d

# Background Worker Settings
EXPIRY_CRON_SCHEDULE="* * * * *"
